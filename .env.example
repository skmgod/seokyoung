# Supabase 연결 설정
# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)
#
# Supabase 대시보드 > 프로젝트 > 상단 [Connect] > "Session pooler" 의 연결 문자열을 붙여넣고
# [YOUR-PASSWORD] 부분을 데이터베이스 비밀번호로 바꾸세요.
# 비밀번호에 @ : / # ? 같은 특수문자가 있으면 URL 인코딩이 필요합니다 (예: @ -> %40).
# 비워두면 이 PC의 instance/housing.db (SQLite)에 저장합니다.
DATABASE_URL=

# 로그인 세션 암호화 키 (클라우드에 올릴 때 긴 임의 문자열로 지정)
SECRET_KEY=

# 로그인 사용 여부. 비워두면 이 PC에서는 로그인 없음, Vercel에서는 로그인 필요. 1=로그인 사용, 0=로그인 없음
REQUIRE_LOGIN=
